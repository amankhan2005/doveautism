# Copy to server/.env for local development. In production, set these in your host's
# environment/secret settings. NEVER commit a real .env file. Placeholders only below.

# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URL of the site, no trailing slash (canonical URLs, sitemap, Open Graph, email logo)
SITE_URL=https://www.doveautism.com
# Extra origins allowed to call /api (comma-separated). Leave empty: the site is same-origin.
CORS_ORIGINS=
# Number of reverse proxies in front of Node (1 behind Nginx or most platforms)
TRUST_PROXY=0

# ── Resend (server only) ───────────────────────────────
# SECRET — sending-only API key from resend.com
RESEND_API_KEY=
# Inbox(es) that receive new inquiries, comma-separated
CONTACT_EMAIL=
# Sender on a domain verified in Resend, e.g. "Dove Autism <website@doveautism.com>"
FROM_EMAIL=
# Email the family a confirmation copy (true/false)
SEND_CONFIRMATION_EMAIL=true
# Contact submissions allowed per 15 minutes per IP
CONTACT_RATE_LIMIT_MAX=5

# ── MongoDB (optional) ─────────────────────────────────
# SECRET — connection string. Leave empty to run without a database.
MONGODB_URI=
# Store anonymous inquiry metadata only (service, contact method, delivery status)
STORE_INQUIRY_METADATA=false

# ── Public contact details (REQUIRE CLIENT CONFIRMATION) ─
# Shown on the site; leave empty to hide.
PUBLIC_PHONE=
PUBLIC_EMAIL=
PUBLIC_ADDRESS=
PUBLIC_HOURS=
PUBLIC_SOCIAL_FACEBOOK=
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_LINKEDIN=
